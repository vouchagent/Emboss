    {
      "type": "paragraph",
      "runs": [
        {
          "text": "Revenue for the third quarter reached $4.53 million, an increase of 11.8% over the prior quarter and 24.1% year over year. Growth was concentrated in the enterprise segment, where annual contract value expanded materially following the platform release in July.",
          "bold": false,
          "italic": false,
          "font_size": null,
          "font_family": null,
          "color": null,
          "link": null
        }
